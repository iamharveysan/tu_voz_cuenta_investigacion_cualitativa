# ── Copia este archivo como .env para desarrollo local. NUNCA subas .env a GitHub. ──

# Clave de OpenAI (solo vive en el servidor). En Render: Environment → Secret.
OPENAI_API_KEY=

# Modelo de OpenAI con salidas estructuradas (JSON Schema). Cámbialo sin tocar código.
OPENAI_MODEL=gpt-5-mini
# Opcional, solo para modelos de razonamiento (gpt-5*, o*): minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# "openai" (real) o "mock" (clasificador local de prueba, SOLO para desarrollo; la app lo señala en pantalla)
AI_MODE=openai

# Contraseña del panel docente (mínimo 10 caracteres)
ADMIN_PASSWORD=

# Secreto largo y aleatorio para firmar la cookie del docente (ej.: openssl rand -hex 32)
SESSION_SECRET=

# Ruta del archivo SQLite. En Render, apúntalo al disco persistente: /var/data/tuvoz.db
DATABASE_PATH=./data/tuvoz.db

# Puerto local de la API en desarrollo (en Render se usa PORT, que Render define solo)
API_PORT=4317
